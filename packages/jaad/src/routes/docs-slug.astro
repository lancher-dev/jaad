---
import { render } from "astro:content";
import { getSortedDocsPages } from "../collection.ts";
import {
  getCanonicalDocSlug,
  getCleanSlug,
  docTitle,
  routedId,
} from "../utils/docs.ts";
import DocsPage from "../components/docs/DocsPage.astro";
import { docsPageHref, withDeploymentBase } from "../urls.ts";
import { buildLocales, docsUrls, localePrefix } from "../docs-config.ts";

interface DocsPath {
  params: { slug: string };
  props: { id: string; locale?: string; isOpening: boolean };
}

export async function getStaticPaths() {
  const paths: DocsPath[] = [];

  for (const locale of buildLocales()) {
    const sortedPages = await getSortedDocsPages(locale);
    const prefix = localePrefix(locale);

    sortedPages.forEach((page, index) => {
      const isOpening = getCanonicalDocSlug(page, index) === "";
      paths.push({
        params: { slug: `${prefix}${getCleanSlug(routedId(page))}` },
        props: { id: page.id, locale, isOpening },
      });

      // A prefixed locale has no index route of its own: /it is this page.
      if (isOpening && prefix) {
        paths.push({
          params: { slug: locale! },
          props: { id: page.id, locale, isOpening: false },
        });
      }
    });
  }

  return paths;
}

const { id, locale, isOpening } = Astro.props;

if (isOpening) {
  return Astro.redirect(docsPageHref("", docsUrls(locale)), 301);
}

const sortedPages = await getSortedDocsPages(locale);
const docPage = sortedPages.find((page) => page.id === id);
if (!docPage) {
  return Astro.redirect(withDeploymentBase("/404", import.meta.env.BASE_URL));
}

const { Content } = await render(docPage);
---

<DocsPage entry={docPage} {sortedPages} headTitle={docTitle(docPage)}>
  <Content />
</DocsPage>
