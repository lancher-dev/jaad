---
import Nav from "./Nav.astro";
import SocialLinks from "./SocialLinks.astro";
import NavMobile from "./NavMobile.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import SearchPalette from "./SearchPalette.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import config from "virtual:jaad/config";
import { getLocaleAlternates, type LocaleAlternate } from "../collection.ts";
import { withDeploymentBase } from "../urls.ts";
import { DEFAULT_LOCALE, ui } from "../docs-config.ts";

interface Props {
  /** Whether this page is part of the docs. */
  inDocs?: boolean;
  locale?: string;
  alternates?: LocaleAlternate[];
}

const { inDocs = false, locale = DEFAULT_LOCALE } = Astro.props;
// A page of the reader's own has no translations: offer each locale's opener.
const alternates = Astro.props.alternates ?? (await getLocaleAlternates(""));
const t = ui(locale);
const homeHref = withDeploymentBase("/", import.meta.env.BASE_URL);
const logoSrc = config.logo
  ? withDeploymentBase(config.logo, import.meta.env.BASE_URL)
  : null;
---

<header class="jaad-chrome" transition:persist>
  <div class="jaad-header-inner">
    <div class="jaad-header-row">
      <span class="jaad-brand font-brand">
        <a href={homeHref} title={t("home")} class="jaad-brand-link">
          {
            logoSrc ? (
              <img src={logoSrc} alt={config.title} class="jaad-logo" />
            ) : (
              config.title
            )
          }
        </a>
      </span>

      <div class="jaad-header-actions">
        <SearchPalette inDocs={inDocs} locale={locale} />
        <Nav />
        <SocialLinks />
        {config.appearance === "auto" && <ThemeSwitcher {locale} />}
        {
          alternates.length > 1 && (
            <LocaleSwitcher {alternates} current={locale} />
          )
        }
        <NavMobile {locale} />
      </div>
    </div>
  </div>
</header>
