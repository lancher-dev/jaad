---
import Nav from "./Nav.astro";
import SocialLinks from "./SocialLinks.astro";
import NavMobile from "./NavMobile.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import SearchPalette from "./SearchPalette.astro";
import config from "virtual:jaad/config";
import { withDeploymentBase } from "../urls.ts";

interface Props {
  /** Whether this page is part of the docs, where search is available. */
  inDocs?: boolean;
}

const { inDocs = false } = Astro.props;
const homeHref = withDeploymentBase("/", import.meta.env.BASE_URL);
const logoSrc = config.logo
  ? withDeploymentBase(config.logo, import.meta.env.BASE_URL)
  : null;
---

<header class="jaad-chrome" transition:persist>
  <div class="container mx-auto p-4">
    <div class="flex items-center gap-4">
      <span class="text-foreground-bright font-brand text-xl">
        <a href={homeHref} title="Home" class="text-primary no-underline">
          {
            logoSrc ? (
              <img src={logoSrc} alt={config.title} class="h-7" />
            ) : (
              config.title
            )
          }
        </a>
      </span>

      <div class="ml-auto flex items-center gap-2">
        <SearchPalette inDocs={inDocs} />
        <Nav />
        <SocialLinks />
        {config.appearance === "auto" && <ThemeSwitcher />}
        <NavMobile />
      </div>
    </div>
  </div>
</header>
