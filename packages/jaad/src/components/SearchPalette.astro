---
import { docsPageHref } from "../urls.ts";
import { DEFAULT_LOCALE, docsUrls, ui } from "../docs-config.ts";

interface Props {
  /** Whether this page is part of the docs. Off them the palette keeps its
   *  icon trigger and its shortcut, and searches the default locale. */
  inDocs?: boolean;
  /** Search covers one locale: the one the reader is in. */
  locale?: string;
}

const { inDocs = false, locale = DEFAULT_LOCALE } = Astro.props;
const urls = docsUrls(locale);
const t = ui(locale);
const base = docsPageHref("", urls);
const indexUrl = docsPageHref("search-index.json", urls);

const MAGNIFIER = "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z";
---

<jaad-search
  data-in-docs={inDocs ? "" : null}
  data-base={base}
  data-index-url={indexUrl}
  data-loading={t("search.loading")}
  data-empty={t("search.empty")}
>
  <button
    data-trigger-desktop
    hidden={!inDocs}
    class="jaad-search-trigger"
    aria-label={t("search.label")}
  >
    <svg
      class="jaad-search-trigger-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d={MAGNIFIER}></path>
    </svg>
    <span class="jaad-search-trigger-label">{t("search.trigger")}</span>
    <kbd data-shortcut class="jaad-search-shortcut">Ctrl K</kbd>
  </button>

  <button
    data-trigger-icon
    class:list={["jaad-icon-button", inDocs && "jaad-search-trigger-compact"]}
    aria-label={t("search.label")}
  >
    <svg
      class="jaad-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d={MAGNIFIER}></path>
    </svg>
  </button>

  <div
    data-overlay
    hidden
    class="jaad-search-overlay"
    role="dialog"
    aria-modal="true"
    aria-label={t("search.label")}
  >
    <div data-backdrop class="jaad-search-backdrop"></div>

    <div class="jaad-search-panel">
      <div class="jaad-search-bar">
        <svg
          class="jaad-search-bar-icon"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d={MAGNIFIER}></path>
        </svg>
        <input
          data-input
          type="text"
          placeholder={t("search.placeholder")}
          class="jaad-search-input"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-expanded="true"
          aria-controls="search-results"
          aria-autocomplete="list"
          aria-label={t("search.label")}
        />
        <kbd data-close class="jaad-search-close">ESC</kbd>
      </div>

      <ul
        data-results
        id="search-results"
        class="jaad-search-results"
        role="listbox"
        aria-label={t("search.results")}
      >
      </ul>

      <div class="jaad-search-footer">
        <span>
          <kbd class="jaad-search-key">↑↓</kbd>
          {t("search.navigate")}
        </span>
        <span>
          <kbd class="jaad-search-key">↵</kbd>
          {t("search.open")}
        </span>
        <span>
          <kbd class="jaad-search-key">esc</kbd>
          {t("search.close")}
        </span>
      </div>
    </div>
  </div>
</jaad-search>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    scoreItems,
    getSnippet,
    splitOnMatches,
    type SearchItem,
  } from "../utils/search.ts";

  class JaadSearch extends HTMLElement {
    #overlay!: HTMLElement;
    #input!: HTMLInputElement;
    #list!: HTMLUListElement;
    #index: SearchItem[] | null = null;
    #request: Promise<SearchItem[]> | null = null;
    #results: SearchItem[] = [];
    #selected = 0;
    #restoreFocus: HTMLElement | null = null;
    #previousOverflow = "";

    get #open() {
      return !this.#overlay.hidden;
    }

    connectedCallback() {
      this.#overlay = this.querySelector("[data-overlay]")!;
      this.#input = this.querySelector("[data-input]")!;
      this.#list = this.querySelector("[data-results]")!;

      if (/Mac|iPod|iPhone|iPad/.test(navigator.userAgent)) {
        this.querySelector("[data-shortcut]")!.textContent = "⌘K";
      }

      for (const sel of ["[data-trigger-desktop]", "[data-trigger-icon]"]) {
        const trigger = this.querySelector<HTMLElement>(sel)!;
        trigger.addEventListener("click", () => this.#setOpen(true));
        trigger.addEventListener("mouseenter", () => void this.#loadIndex());
        trigger.addEventListener("focus", () => void this.#loadIndex());
      }

      this.querySelector("[data-backdrop]")!.addEventListener("click", () =>
        this.#setOpen(false),
      );
      this.querySelector("[data-close]")!.addEventListener("click", () =>
        this.#setOpen(false),
      );

      this.#input.addEventListener("input", () => this.#render());
      this.#input.addEventListener("keydown", (e) => this.#onInputKey(e));

      document.addEventListener("keydown", this.#onGlobalKey);
      document.addEventListener("astro:before-swap", this.#syncLocale);
    }

    disconnectedCallback() {
      document.removeEventListener("keydown", this.#onGlobalKey);
      document.removeEventListener("astro:before-swap", this.#syncLocale);
    }

    /** Each locale has its own index, so a language switch drops the cache. */
    #syncLocale = (event: Event) => {
      const next = (
        event as Event & { newDocument: Document }
      ).newDocument.querySelector<HTMLElement>("jaad-search");
      if (!next) return;

      const indexUrl = next.dataset.indexUrl;
      if (indexUrl && indexUrl !== this.dataset.indexUrl) {
        this.dataset.indexUrl = indexUrl;
        this.#index = null;
        this.#request = null;
      }
      if (next.dataset.base) this.dataset.base = next.dataset.base;
    };

    #onGlobalKey = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        this.#setOpen(!this.#open);
      } else if (e.key === "Escape" && this.#open) {
        e.preventDefault();
        this.#setOpen(false);
      }
    };

    #onInputKey(e: KeyboardEvent) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        this.#select(Math.min(this.#selected + 1, this.#results.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        this.#select(Math.max(this.#selected - 1, 0));
      } else if (e.key === "Enter" && this.#results[this.#selected]) {
        this.#go(this.#results[this.#selected].slug);
      }
    }

    #loadIndex(): Promise<SearchItem[]> {
      if (this.#index) return Promise.resolve(this.#index);
      if (!this.#request) {
        const url = this.dataset.indexUrl ?? "/search-index.json";
        this.#request = fetch(url)
          .then((res) => (res.ok ? res.json() : []))
          .then((data: SearchItem[]) => (this.#index = data))
          .catch(() => {
            // Drop the failed promise so a later attempt can retry.
            this.#request = null;
            return [];
          });
      }
      return this.#request;
    }

    #setOpen(open: boolean) {
      if (open === this.#open) return;
      this.#overlay.hidden = !open;

      if (open) {
        this.#restoreFocus = document.activeElement as HTMLElement | null;
        this.#previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => this.#input.focus());
        void this.#loadIndex().then(() => this.#render());
        this.#render();
      } else {
        document.body.style.overflow = this.#previousOverflow;
        this.#input.value = "";
        this.#restoreFocus?.focus?.();
      }
    }

    #go(slug: string) {
      this.#setOpen(false);
      const base = this.dataset.base ?? "/";
      const prefix = base === "/" ? "" : base.replace(/\/$/, "");
      navigate(slug ? `${prefix}/${slug}` : base);
    }

    #select(i: number) {
      this.#selected = i;
      this.#input.setAttribute("aria-activedescendant", `search-option-${i}`);
      [...this.#list.children].forEach((li, n) => {
        const active = n === i;
        li.setAttribute("aria-selected", String(active));
      });
      (this.#list.children[i] as HTMLElement | undefined)?.scrollIntoView({
        block: "nearest",
      });
    }

    #marked(text: string, query: string): DocumentFragment {
      const frag = document.createDocumentFragment();
      for (const part of splitOnMatches(text, query)) {
        if (part.match) {
          const mark = document.createElement("mark");
          mark.className = "jaad-search-mark";
          mark.textContent = part.text;
          frag.append(mark);
        } else {
          frag.append(document.createTextNode(part.text));
        }
      }
      return frag;
    }

    #render() {
      const query = this.#input.value;
      this.#list.replaceChildren();
      this.#input.removeAttribute("aria-activedescendant");

      if (!this.#index) {
        this.#list.append(this.#message(this.dataset.loading ?? "Loading..."));
        return;
      }

      this.#results = scoreItems(this.#index, query);

      if (this.#results.length === 0) {
        this.#list.append(
          this.#message(`${this.dataset.empty ?? "No results for"} “${query}”`),
        );
        return;
      }

      this.#results.forEach((item, i) => {
        const li = document.createElement("li");
        li.id = `search-option-${i}`;
        li.setAttribute("role", "option");
        li.className = "jaad-search-result";
        li.addEventListener("click", () => this.#go(item.slug));
        li.addEventListener("mouseenter", () => this.#select(i));

        const head = document.createElement("div");
        head.className = "jaad-search-result-head";
        const title = document.createElement("span");
        title.className = "jaad-search-result-title";
        title.append(this.#marked(item.title, query));
        head.append(title);

        if (item.chapter) {
          const badge = document.createElement("span");
          badge.className = "jaad-search-result-badge";
          badge.textContent = item.chapter;
          head.append(badge);
        }
        li.append(head);

        const snippet = getSnippet(item.body, query);
        if (snippet) {
          const p = document.createElement("p");
          p.className = "jaad-search-result-snippet";
          p.append(this.#marked(snippet, query));
          li.append(p);
        }

        this.#list.append(li);
      });

      this.#select(0);
    }

    #message(text: string): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "jaad-search-message";
      li.textContent = text;
      return li;
    }
  }

  if (!customElements.get("jaad-search")) {
    customElements.define("jaad-search", JaadSearch);
  }
</script>
