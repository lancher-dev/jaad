---
import { formatChapterTitle } from "../../utils/docs.ts";
import config from "virtual:jaad/config";

interface Props {
  chapter?: string;
  title: string;
}

const { chapter, title } = Astro.props;
const chapterTitle = formatChapterTitle(chapter);

const rootLabel =
  formatChapterTitle(config.docsBase.replace(/^\//, "")) ?? "Docs";
---

<nav
  aria-label="Breadcrumb"
  class="text-foreground-muted mb-4 flex items-center gap-1.5 text-xs"
>
  <a
    href={config.docsBase || "/"}
    class="hover:text-foreground-bright no-underline">{rootLabel}</a
  >
  {
    chapterTitle && (
      <>
        <span aria-hidden="true">/</span>
        <span>{chapterTitle}</span>
      </>
    )
  }
  <span aria-hidden="true">/</span>
  <span class="text-foreground-bright font-medium" aria-current="page">
    {title}
  </span>
</nav>
