---
import config from "virtual:jaad/config";
import { formatChapterTitle } from "../../utils/docs.ts";

interface Props {
  title: string;
  description: string;
  chapter?: string;
}

const { title, description, chapter } = Astro.props;

// Without `site` there is no absolute URL to point at, and relative ids are
// worthless to a crawler.
const site = Astro.site;
const base = site ? config.routeBase.replace(/\/$/, "") : null;

const crumbs = base
  ? [
      { name: config.title, url: new URL(base || "/", site!).href },
      ...(chapter ? [{ name: formatChapterTitle(chapter)!, url: null }] : []),
      { name: title, url: Astro.url.href },
    ]
  : [];

const data = base && {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  inLanguage: config.lang,
  isPartOf: { "@type": "WebSite", name: config.title },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      ...(crumb.url ? { item: crumb.url } : {}),
    })),
  },
};
---

{
  data && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(data)}
      is:inline
    />
  )
}
