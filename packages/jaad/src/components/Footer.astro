---
import config from "virtual:jaad/config";

const CREDIT =
  'Built with <a href="https://jaad.lancher.dev" rel="noopener">JAAD</a>.';

// Unset is the credit alone; `footer: false` removes it.
const line = config.footer === undefined ? ":credit" : config.footer;
const html = line === false ? null : line.replaceAll(":credit", CREDIT);
---

{
  html && (
    <footer
      class="jaad-chrome border-border-dark mt-4 border-t pt-2"
      aria-labelledby="footer-heading"
    >
      <h2 class="sr-only" id="footer-heading">
        Site footer
      </h2>
      <p
        class="text-foreground-muted mb-1 text-center text-[0.95rem] leading-[1.6] italic"
        set:html={html}
      />
    </footer>
  )
}
