---

<jaad-scroll-top>
  <button
    class="bg-background text-foreground hover:bg-background/80 border-foreground/20 pointer-events-none fixed right-6 bottom-6 z-50 flex h-12 w-12 items-center justify-center rounded-full border opacity-0 shadow-lg transition-opacity duration-300 lg:hidden"
    aria-label="Scroll to top"
  >
    <svg
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</jaad-scroll-top>

<script>
  const SHOW_AFTER = 300;

  class JaadScrollTop extends HTMLElement {
    #button: HTMLButtonElement | null = null;
    #onScroll = () => {
      const shown = window.scrollY > SHOW_AFTER;
      this.#button?.classList.toggle("opacity-100", shown);
      this.#button?.classList.toggle("pointer-events-auto", shown);
      this.#button?.classList.toggle("opacity-0", !shown);
      this.#button?.classList.toggle("pointer-events-none", !shown);
    };

    connectedCallback() {
      this.#button = this.querySelector("button");
      this.#button?.addEventListener("click", () => {
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
      });
      window.addEventListener("scroll", this.#onScroll, { passive: true });
      this.#onScroll();
    }

    disconnectedCallback() {
      window.removeEventListener("scroll", this.#onScroll);
    }
  }

  if (!customElements.get("jaad-scroll-top")) {
    customElements.define("jaad-scroll-top", JaadScrollTop);
  }
</script>
