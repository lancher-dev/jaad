---
import { ui } from "../docs-config.ts";

const t = ui(Astro.props.locale);
---

<jaad-scroll-top>
  <button class="jaad-scroll-top-button" aria-label={t("scrollTop")}>
    <svg
      class="jaad-scroll-top-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</jaad-scroll-top>

<script>
  const SHOW_AFTER = 300;

  class JaadScrollTop extends HTMLElement {
    #button: HTMLButtonElement | null = null;
    #onScroll = () => {
      const shown = window.scrollY > SHOW_AFTER;
      this.#button?.toggleAttribute("data-visible", shown);
    };

    connectedCallback() {
      this.#button = this.querySelector("button");
      this.#button?.addEventListener("click", () => {
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
      });
      window.addEventListener("scroll", this.#onScroll, { passive: true });
      this.#onScroll();
    }

    disconnectedCallback() {
      window.removeEventListener("scroll", this.#onScroll);
    }
  }

  if (!customElements.get("jaad-scroll-top")) {
    customElements.define("jaad-scroll-top", JaadScrollTop);
  }
</script>
