---
import config from "virtual:jaad/config";
import { withDeploymentBase } from "../urls.ts";
import { ui } from "../docs-config.ts";

const links = config.nav;
const t = ui(Astro.props.locale);
---

{
  links.length > 0 && (
    <jaad-nav-mobile class="relative md:hidden">
      <button
        class="jaad-icon-button"
        aria-label={t("nav.mobile")}
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="jaad-nav-menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            data-icon-open
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
          <path
            data-icon-close
            class="hidden"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>

      <div id="jaad-nav-menu" data-menu hidden class="jaad-menu">
        <nav class="p-2">
          <ul class="flex flex-col gap-1">
            {links.map((link) => (
              <li>
                <a
                  href={withDeploymentBase(link.href, import.meta.env.BASE_URL)}
                  class="jaad-menu-item"
                  {...(link.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </jaad-nav-mobile>
  )
}

<script>
  class JaadNavMobile extends HTMLElement {
    #button!: HTMLButtonElement;
    #menu!: HTMLElement;

    #onPointer = (e: PointerEvent) => {
      if (!this.contains(e.target as Node)) this.#setOpen(false);
    };
    #onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") this.#setOpen(false);
    };

    #setOpen(open: boolean) {
      this.#menu.hidden = !open;
      this.#button.setAttribute("aria-expanded", String(open));
      this.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      this.querySelector("[data-icon-close]")?.classList.toggle(
        "hidden",
        !open,
      );

      if (open) {
        document.addEventListener("pointerdown", this.#onPointer);
        document.addEventListener("keydown", this.#onKey);
      } else {
        document.removeEventListener("pointerdown", this.#onPointer);
        document.removeEventListener("keydown", this.#onKey);
      }
    }

    connectedCallback() {
      this.#button = this.querySelector("button")!;
      this.#menu = this.querySelector("[data-menu]")!;

      this.#button.addEventListener("click", () => {
        this.#setOpen(Boolean(this.#menu.hidden));
      });
      this.#menu.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) this.#setOpen(false);
      });
    }

    disconnectedCallback() {
      document.removeEventListener("pointerdown", this.#onPointer);
      document.removeEventListener("keydown", this.#onKey);
    }
  }

  if (!customElements.get("jaad-nav-mobile")) {
    customElements.define("jaad-nav-mobile", JaadNavMobile);
  }
</script>
