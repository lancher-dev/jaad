---
import { withBase } from "../utils/base";
import "../styles/site.css";

interface Props {
  pageTitle?: string;
  description?: string;
}

const {
  pageTitle,
  description = "A website with its own JAAD documentation.",
} = Astro.props;
const title = [pageTitle, "__JAAD_TITLE__"].filter(Boolean).join(" | ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <header class="site-chrome site-header">
      <a class="site-name" href={withBase("/")}>{"__JAAD_TITLE__"}</a>
      <nav aria-label="Main navigation">
        <a href={withBase("/docs")}>Documentation</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-chrome site-footer">Built with JAAD.</footer>
  </body>
</html>
