---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Consumer Test</title>
  </head>
  <body data-site-layout>
    <main><slot /></main>
  </body>
</html>
