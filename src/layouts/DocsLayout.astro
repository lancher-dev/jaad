---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import DocsSidebarLeft from "@/components/docs/DocsSidebarLeft.astro";
import TableOfContents from "@/components/docs/TableOfContents.astro";
import {
  extractHeadingsFromMarkdown,
  sortDocPages,
  buildSearchIndex,
} from "@/utils/docs";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import "@/styles/global.css";
import "@/styles/docs.css";
import "@/styles/jaamd.css";
import "jaamd/styles.css";

interface Props {
  title?: string;
  currentSlug?: string;
  entry?: CollectionEntry<"docsPages">;
}

const { title, currentSlug = "", entry } = Astro.props;

// Set dynamic page title
const pageTitle = `${title ? `${title} | ` : ""}JAAD - Docs`;

// Extract headings from markdown content
const headings = entry ? extractHeadingsFromMarkdown(entry.body || "") : [];

// Build static search index from collections
const docsCollection = await getCollection("docsPages");
const searchIndex = buildSearchIndex(sortDocPages(docsCollection));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="JAAD - Just Another Astro Docs. A clean, minimalist documentation framework."
    />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-merriweather" preload />

    <!-- Open Graph Meta Tags -->
    <meta property="og:url" content="#" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="JAAD - Just Another Astro Docs" />
    <meta property="og:description" content="JAAD - Just Another Astro Docs" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="#" />
    <meta property="twitter:url" content="#" />
    <meta name="twitter:title" content="JAAD - Just Another Astro Docs" />
    <meta name="twitter:description" content="JAAD - Just Another Astro Docs" />
    <meta name="twitter:image" content="/og-image.png" />

    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        function isDark() {
          var t = localStorage.getItem("theme");
          return (
            t === "dark" ||
            (!t && matchMedia("(prefers-color-scheme: dark)").matches)
          );
        }
        function applyTheme(root) {
          if (isDark()) {
            root.classList.add("dark");
          } else {
            root.classList.remove("dark");
          }
        }
        applyTheme(document.documentElement);
        document.addEventListener("astro:before-swap", function (e) {
          applyTheme(e.newDocument.documentElement);
        });
        document.addEventListener("astro:after-swap", function () {
          applyTheme(document.documentElement);
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background text-foreground flex min-h-screen flex-col text-[14px] leading-[1.6]"
  >
    <Header />

    <!-- Static search index, built at compile time from collections -->
    <script
      id="jaad-search-index"
      type="application/json"
      set:html={JSON.stringify(searchIndex)}
    />

    <div class="docs-container relative">
      <DocsSidebarLeft currentSlug={currentSlug} />

      <div class="docs-main lg:mr-64 lg:ml-64">
        <slot />
      </div>

      <TableOfContents headings={headings} />
    </div>

    <Footer />

    <script is:inline>
      (function () {
        function navigate() {
          var nav = document.querySelector('nav[aria-label="Page navigation"]');
          if (!nav) return;
          var links = nav.querySelectorAll("a[href]");
          var prev = null,
            next = null;
          links.forEach(function (a) {
            var icon = a.querySelector("i");
            if (!icon) return;
            if (icon.classList.contains("nf-md-chevron_left")) prev = a;
            if (icon.classList.contains("nf-md-chevron_right")) next = a;
          });
          return { prev: prev, next: next };
        }
        function onKey(e) {
          var tag = document.activeElement && document.activeElement.tagName;
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          if (
            document.activeElement &&
            document.activeElement.isContentEditable
          )
            return;
          var pages = navigate();
          if (!pages) return;
          if (e.key === "ArrowLeft" && pages.prev) {
            e.preventDefault();
            pages.prev.click();
          }
          if (e.key === "ArrowRight" && pages.next) {
            e.preventDefault();
            pages.next.click();
          }
        }
        document.addEventListener("keydown", onKey);
        document.addEventListener("astro:after-swap", function () {
          document.removeEventListener("keydown", onKey);
          document.addEventListener("keydown", onKey);
        });
      })();
    </script>
  </body>
</html>
