---
interface Props {
  /** Content collection entry id, e.g. "03-markdown/12-inner-html". */
  id: string;
  /** URL-safe slug, e.g. "markdown/inner-html". */
  cleanSlug: string;
}

const { id, cleanSlug } = Astro.props;

const mdHref = `/docs/${cleanSlug}.md`;
const editUrl = `https://github.com/lancher-dev/jaad/edit/main/docs/${id}.md`;
---

<div class="mb-4 flex items-center gap-2 text-xs">
  <button
    type="button"
    data-copy-page
    data-md-href={mdHref}
    class="border-border bg-surface hover:bg-surface-hover text-foreground-secondary hover:text-foreground-bright flex cursor-pointer items-center gap-1.5 rounded-lg border px-3 py-1.5 transition-colors"
  >
    <svg
      class="h-3.5 w-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M16 1H4a2 2 0 00-2 2v14h2V3h12V1zm3 4H8a2 2 0 00-2 2v14a2 2 0 002 2h11a2 2 0 002-2V7a2 2 0 00-2-2z"
      ></path>
    </svg>
    <span data-copy-label>Copy page</span>
  </button>

  <a
    href={editUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="border-border bg-surface hover:bg-surface-hover text-foreground-secondary hover:text-foreground-bright flex items-center gap-1.5 rounded-lg border px-3 py-1.5 no-underline transition-colors"
  >
    <svg
      class="h-3.5 w-3.5 shrink-0"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.5 10.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"
      ></path>
    </svg>
    <span>Edit this page</span>
  </a>
</div>

<script>
  function initCopyPageButtons(): void {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-page]")
      .forEach((btn) => {
        if (btn.dataset.copyInit) return;
        btn.dataset.copyInit = "1";

        const label = btn.querySelector<HTMLElement>("[data-copy-label]");

        btn.addEventListener("click", async () => {
          const href = btn.dataset.mdHref;
          if (!href) return;
          try {
            const res = await fetch(href);
            const text = await res.text();
            await navigator.clipboard.writeText(text);
            if (label) {
              const original = label.textContent;
              label.textContent = "Copied!";
              setTimeout(() => {
                label.textContent = original;
              }, 2000);
            }
          } catch {
            // Network or clipboard unavailable — fail silently.
          }
        });
      });
  }

  initCopyPageButtons();
  document.addEventListener("astro:page-load", initCopyPageButtons);
</script>
