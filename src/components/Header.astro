---
import Nav from "./Nav.astro";
import NavMobile from "./NavMobile";
import ThemeSwitcher from "./ThemeSwitcher";
import SearchPalette from "./SearchPalette";

interface Props {
  /**
   * Whether this page is part of the docs, where search is available
   */
  inDocs?: boolean;
}

const { inDocs = false } = Astro.props;
---

<header class="w-full" aria-labelledby="header-heading" transition:persist>
  <div class="container mx-auto p-4">
    <div class="flex items-center gap-4">
      <span class="text-foreground-bright font-brand text-xl">
        <a href="/" title="Home" class="text-primary no-underline">JAAD</a>
      </span>

      <div class="ml-auto flex items-center gap-2">
        {
          /* All three render fully on the server, so hydration can be
             deferred. NavMobile is `md:hidden` and never hydrates on desktop. */
        }
        <SearchPalette client:idle inDocs={inDocs} />
        <Nav />
        <ThemeSwitcher client:idle />
        <NavMobile client:media="(max-width: 767px)" />
      </div>
    </div>
  </div>
</header>
